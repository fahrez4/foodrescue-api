{
  "swagger": "2.0",
  "info": {
    "title": "FoodRescue API",
    "description": "REST API backend untuk aplikasi mobile Flutter \"FoodRescue\" — platform penyelamatan dan donasi surplus makanan.",
    "version": "1.0.0",
    "contact": { "name": "FoodRescue Dev Team", "email": "support@foodrescue.id" },
    "license": { "name": "MIT" }
  },
  "host": "139.190.96.203:8091",
  "basePath": "/api/v1",
  "schemes": ["http"],
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Masukkan: `Bearer <token_jwt>`"
    }
  },
  "tags": [
    { "name": "Health", "description": "Pengecekan status API" },
    { "name": "Auth", "description": "Registrasi, login, profil, Google Sign-In" },
    { "name": "Users", "description": "Profil user publik, impact, metode pembayaran" },
    { "name": "Toko", "description": "Profil toko & rekan penyelamat makanan" },
    { "name": "Kurir", "description": "Profil kurir, status online, pengantaran" },
    { "name": "Listings", "description": "Listing surplus makanan" },
    { "name": "Orders", "description": "Pesanan makanan" },
    { "name": "Deliveries", "description": "Pengantaran oleh kurir" },
    { "name": "Community", "description": "Donasi kompos & pakan ternak" },
    { "name": "Emergency", "description": "Alert darurat & respons toko" },
    { "name": "Ratings", "description": "Rating toko / kurir / user" },
    { "name": "Reports", "description": "Laporan penyalahgunaan" },
    { "name": "Chats", "description": "Obrolan user–toko" },
    { "name": "AI", "description": "Asisten AI Gemini (nutrisi & deteksi kamera)" },
    { "name": "Payments", "description": "Pembayaran Midtrans & notifikasi" },
    { "name": "Admin", "description": "Manajemen & moderasi (khusus admin)" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "produces": ["application/json"],
        "responses": { "200": { "description": "OK", "schema": { "$ref": "#/definitions/Health" } } }
      }
    },

    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registrasi user baru (user / toko / kurir)",
        "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/RegisterRequest" } }],
        "responses": {
          "200": { "description": "Berhasil — kembalikan token + user", "schema": { "$ref": "#/definitions/AuthResponse" } },
          "409": { "description": "Email sudah terdaftar" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login dengan email & password",
        "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/LoginRequest" } }],
        "responses": {
          "200": { "description": "Berhasil", "schema": { "$ref": "#/definitions/AuthResponse" } },
          "401": { "description": "Email/password salah" }
        }
      }
    },
    "/auth/google": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login dengan Google ID Token",
        "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/GoogleLoginRequest" } }],
        "responses": { "200": { "description": "Berhasil", "schema": { "$ref": "#/definitions/AuthResponse" } } }
      }
    },
    "/auth/google/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registrasi user baru via Google (role + no HP)",
        "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/GoogleRegisterRequest" } }],
        "responses": { "200": { "description": "Berhasil", "schema": { "$ref": "#/definitions/AuthResponse" } } }
      }
    },
    "/auth/profile": {
      "get": {
        "tags": ["Auth"], "security": [{ "BearerAuth": [] }],
        "summary": "Get profil user yang login",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Profil", "schema": { "$ref": "#/definitions/User" } } }
      },
      "put": {
        "tags": ["Auth"], "security": [{ "BearerAuth": [] }],
        "summary": "Update profil (nama, foto, telepon, alamat, koordinat)",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/UpdateProfileRequest" } }],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },

    "/users/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get profil user publik",
        "produces": ["application/json"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Profil user", "schema": { "$ref": "#/definitions/User" } } }
      }
    },
    "/users/me/impact": {
      "get": {
        "tags": ["Users"], "security": [{ "BearerAuth": [] }],
        "summary": "Total makanan diselamatkan user (kg, order, CO2)",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Dampak" } }
      }
    },
    "/users/payment-methods": {
      "post": {
        "tags": ["Users"], "security": [{ "BearerAuth": [] }],
        "summary": "Daftar metode pembayaran baru",
        "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/PaymentMethodCreate" } }],
        "responses": { "201": { "description": "Berhasil" } }
      },
      "get": {
        "tags": ["Users"], "security": [{ "BearerAuth": [] }],
        "summary": "Daftar metode pembayaran user",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Daftar metode" } }
      }
    },

    "/tokos": {
      "get": {
        "tags": ["Toko"],
        "summary": "Daftar toko terverifikasi (publik)",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Daftar toko" } }
      },
      "post": {
        "tags": ["Toko"], "security": [{ "BearerAuth": [] }],
        "summary": "Buat profil toko (status pending, tunggu verifikasi admin)",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/TokoProfileCreate" } }],
        "responses": { "201": { "description": "Berhasil dibuat" } }
      }
    },
    "/tokos/{id}": {
      "get": {
        "tags": ["Toko"],
        "summary": "Detail toko terverifikasi",
        "produces": ["application/json"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Toko", "schema": { "$ref": "#/definitions/TokoProfile" } } }
      }
    },
    "/tokos/me/profile": {
      "get": {
        "tags": ["Toko"], "security": [{ "BearerAuth": [] }],
        "summary": "Get profil toko milik saya (role toko)",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Profil toko", "schema": { "$ref": "#/definitions/TokoProfile" } } }
      },
      "put": {
        "tags": ["Toko"], "security": [{ "BearerAuth": [] }],
        "summary": "Update profil toko milik saya",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/TokoProfileCreate" } }],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },
    "/tokos/me/analytics": {
      "get": {
        "tags": ["Toko"], "security": [{ "BearerAuth": [] }],
        "summary": "Statistik penjualan toko",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Analitik" } }
      }
    },
    "/tokos/me/ratings": {
      "get": {
        "tags": ["Toko"], "security": [{ "BearerAuth": [] }],
        "summary": "Daftar rating yang diterima toko",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Daftar rating" } }
      }
    },

    "/kurirs/me/profile": {
      "get": {
        "tags": ["Kurir"], "security": [{ "BearerAuth": [] }],
        "summary": "Get profil kurir milik saya",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Profil kurir", "schema": { "$ref": "#/definitions/CourierProfile" } } }
      },
      "put": {
        "tags": ["Kurir"], "security": [{ "BearerAuth": [] }],
        "summary": "Update profil kurir (kendaraan, dokumen)",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/CourierProfileUpdate" } }],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },
    "/kurirs/me/online": {
      "patch": {
        "tags": ["Kurir"], "security": [{ "BearerAuth": [] }],
        "summary": "Toggle status online kurir",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/ToggleOnlineRequest" } }],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },
    "/kurirs/me/location": {
      "put": {
        "tags": ["Kurir"], "security": [{ "BearerAuth": [] }],
        "summary": "Update koordinat kurir",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/LocationRequest" } }],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },
    "/kurirs/deliveries/pending": {
      "get": {
        "tags": ["Kurir"], "security": [{ "BearerAuth": [] }],
        "summary": "Daftar pengantaran yang sedang mencari kurir",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Daftar" } }
      }
    },
    "/kurirs/deliveries/accept": {
      "post": {
        "tags": ["Kurir"], "security": [{ "BearerAuth": [] }],
        "summary": "Terima penawaran pengantaran",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/DeliveryIDRequest" } }],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },
    "/kurirs/deliveries/trip": {
      "put": {
        "tags": ["Kurir"], "security": [{ "BearerAuth": [] }],
        "summary": "Update status perjalanan (menuju_toko / barang_diambil / menuju_user / diterima_user)",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/TripStatusRequest" } }],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },
    "/kurirs/deliveries/confirm-pickup": {
      "post": {
        "tags": ["Kurir"], "security": [{ "BearerAuth": [] }],
        "summary": "Konfirmasi ambil barang (kode pickup)",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/ConfirmationCodeRequest" } }],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },
    "/kurirs/deliveries/confirm-dropoff": {
      "post": {
        "tags": ["Kurir"], "security": [{ "BearerAuth": [] }],
        "summary": "Konfirmasi antar barang (kode dropoff)",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/ConfirmationCodeRequest" } }],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },
    "/kurirs/me/earnings": {
      "get": {
        "tags": ["Kurir"], "security": [{ "BearerAuth": [] }],
        "summary": "Total & rincian pendapatan kurir",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Pendapatan" } }
      }
    },

    "/listings": {
      "get": {
        "tags": ["Listings"],
        "summary": "Daftar listing aktif (publik, paginated, bisa filter & search)",
        "produces": ["application/json"],
        "parameters": [
          { "in": "query", "name": "page", "type": "integer", "default": 1 },
          { "in": "query", "name": "limit", "type": "integer", "default": 20 },
          { "in": "query", "name": "category", "type": "string" },
          { "in": "query", "name": "search", "type": "string" }
        ],
        "responses": { "200": { "description": "Hasil", "schema": { "$ref": "#/definitions/PaginatedResponse" } } }
      },
      "post": {
        "tags": ["Listings"], "security": [{ "BearerAuth": [] }],
        "summary": "Buat listing baru (role toko, harus terverifikasi)",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/CreateListingRequest" } }],
        "responses": { "201": { "description": "Listing dibuat" } }
      }
    },
    "/listings/{id}": {
      "get": {
        "tags": ["Listings"],
        "summary": "Detail listing",
        "produces": ["application/json"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Listing", "schema": { "$ref": "#/definitions/FoodListing" } } }
      },
      "put": {
        "tags": ["Listings"], "security": [{ "BearerAuth": [] }],
        "summary": "Update listing (hanya pemilik toko)",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "type": "string" },
          { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/UpdateListingRequest" } }
        ],
        "responses": { "200": { "description": "Berhasil" } }
      },
      "delete": {
        "tags": ["Listings"], "security": [{ "BearerAuth": [] }],
        "summary": "Hapus listing (hanya pemilik toko)",
        "produces": ["application/json"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },
    "/listings/me/listings": {
      "get": {
        "tags": ["Listings"], "security": [{ "BearerAuth": [] }],
        "summary": "Daftar listing milik toko saya",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Daftar listing" } }
      }
    },

    "/orders": {
      "post": {
        "tags": ["Orders"], "security": [{ "BearerAuth": [] }],
        "summary": "Buat order (role user)",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/CreateOrderRequest" } }],
        "responses": { "201": { "description": "Order dibuat (+ confirmation_code)" } }
      }
    },
    "/orders/me": {
      "get": {
        "tags": ["Orders"], "security": [{ "BearerAuth": [] }],
        "summary": "Daftar order saya (user)",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Daftar order" } }
      }
    },
    "/orders/{id}": {
      "get": {
        "tags": ["Orders"], "security": [{ "BearerAuth": [] }],
        "summary": "Detail order",
        "produces": ["application/json"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Order", "schema": { "$ref": "#/definitions/Order" } } }
      }
    },
    "/orders/{id}/cancel": {
      "post": {
        "tags": ["Orders"], "security": [{ "BearerAuth": [] }],
        "summary": "Batalkan order",
        "produces": ["application/json"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },
    "/orders/{id}/confirm-payment": {
      "post": {
        "tags": ["Orders"], "security": [{ "BearerAuth": [] }],
        "summary": "Konfirmasi pembayaran manual",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "type": "string" },
          { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/ConfirmPaymentRequest" } }
        ],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },

    "/deliveries/order/{order_id}": {
      "get": {
        "tags": ["Deliveries"], "security": [{ "BearerAuth": [] }],
        "summary": "Cek status pengantaran dari order",
        "produces": ["application/json"],
        "parameters": [{ "in": "path", "name": "order_id", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Pengantaran", "schema": { "$ref": "#/definitions/Delivery" } } }
      }
    },
    "/deliveries/me": {
      "get": {
        "tags": ["Deliveries"], "security": [{ "BearerAuth": [] }],
        "summary": "Daftar pengantaran saya (kurir)",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Daftar" } }
      }
    },

    "/community": {
      "get": {
        "tags": ["Community"],
        "summary": "Daftar posting donasi komunitas",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Daftar posting" } }
      },
      "post": {
        "tags": ["Community"], "security": [{ "BearerAuth": [] }],
        "summary": "Buat posting komunitas dari listing (role toko)",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/CreateCommunityPostRequest" } }],
        "responses": { "201": { "description": "Berhasil" } }
      }
    },
    "/community/claim": {
      "post": {
        "tags": ["Community"], "security": [{ "BearerAuth": [] }],
        "summary": "Klaim posting donasi (role user)",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/ClaimCommunityPostRequest" } }],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },
    "/community/{id}/confirm": {
      "post": {
        "tags": ["Community"], "security": [{ "BearerAuth": [] }],
        "summary": "Konfirmasi pickup donasi",
        "produces": ["application/json"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },

    "/emergency/alerts": {
      "get": {
        "tags": ["Emergency"],
        "summary": "Daftar alert aktif (publik)",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Daftar alert" } }
      },
      "post": {
        "tags": ["Emergency"], "security": [{ "BearerAuth": [] }],
        "summary": "Buat alert darurat (role user, wajib terverifikasi NGO)",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/CreateEmergencyAlertRequest" } }],
        "responses": { "201": { "description": "Berhasil" } }
      }
    },
    "/emergency/alerts/{id}/responses": {
      "get": {
        "tags": ["Emergency"],
        "summary": "Daftar respons toko terhadap alert",
        "produces": ["application/json"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Daftar respons" } }
      }
    },
    "/emergency/responses": {
      "post": {
        "tags": ["Emergency"], "security": [{ "BearerAuth": [] }],
        "summary": "Toko merespons alert darurat",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/RespondEmergencyAlertRequest" } }],
        "responses": { "201": { "description": "Berhasil" } }
      }
    },

    "/ratings/{id}": {
      "get": {
        "tags": ["Ratings"],
        "summary": "Daftar rating untuk target user (opsional query `target` = toko|kurir|user)",
        "produces": ["application/json"],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "type": "string" },
          { "in": "query", "name": "target", "type": "string" }
        ],
        "responses": { "200": { "description": "Daftar rating" } }
      }
    },
    "/ratings": {
      "post": {
        "tags": ["Ratings"], "security": [{ "BearerAuth": [] }],
        "summary": "Beri rating (toko/kurir/user)",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/CreateRatingRequest" } }],
        "responses": { "201": { "description": "Berhasil" } }
      }
    },
    "/ratings/me/given": {
      "get": {
        "tags": ["Ratings"], "security": [{ "BearerAuth": [] }],
        "summary": "Daftar rating yang pernah saya berikan",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Daftar" } }
      }
    },

    "/reports": {
      "post": {
        "tags": ["Reports"], "security": [{ "BearerAuth": [] }],
        "summary": "Buat laporan penyalahgunaan",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/CreateReportRequest" } }],
        "responses": { "201": { "description": "Berhasil" } }
      }
    },
    "/reports/me": {
      "get": {
        "tags": ["Reports"], "security": [{ "BearerAuth": [] }],
        "summary": "Daftar laporan saya",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Daftar" } }
      }
    },

    "/chats": {
      "post": {
        "tags": ["Chats"], "security": [{ "BearerAuth": [] }],
        "summary": "Buka chat untuk sebuah order",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/CreateChatRequest" } }],
        "responses": { "201": { "description": "Berhasil" } }
      }
    },
    "/chats/me": {
      "get": {
        "tags": ["Chats"], "security": [{ "BearerAuth": [] }],
        "summary": "Daftar chat saya",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Daftar chat" } }
      }
    },
    "/chats/{id}/messages": {
      "get": {
