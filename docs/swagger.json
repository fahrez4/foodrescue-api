        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/DetectPhotoRequest" } }],
        "responses": { "200": { "description": "Hasil deteksi" } }
      }
    },
    "/ai/conversations/{id}/messages": {
      "get": {
        "tags": ["AI"], "security": [{ "BearerAuth": [] }],
        "summary": "Riwayat percakapan AI",
        "produces": ["application/json"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Pesan" } }
      },
      "post": {
        "tags": ["AI"], "security": [{ "BearerAuth": [] }],
        "summary": "Lanjutkan percakapan AI",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "type": "string" },
          { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/AIContinueRequest" } }
        ],
        "responses": { "200": { "description": "Balasan" } }
      }
    },

    "/payments/create": {
      "post": {
        "tags": ["Payments"], "security": [{ "BearerAuth": [] }],
        "summary": "Buat transaksi pembayaran (Midtrans SNAP / manual)",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/CreatePaymentRequest" } }],
        "responses": { "200": { "description": "Data pembayaran" } }
      }
    },
    "/payments/notification": {
      "post": {
        "tags": ["Payments"],
        "summary": "Webhook notifikasi Midtrans",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [{ "in": "body", "name": "body", "required": true }],
        "responses": { "200": { "description": "OK" } }
      }
    },

    "/admin/dashboard": {
      "get": {
        "tags": ["Admin"], "security": [{ "BearerAuth": [] }],
        "summary": "Dashboard analitik admin",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Analitik" } }
      }
    },
    "/admin/users": {
      "get": {
        "tags": ["Admin"], "security": [{ "BearerAuth": [] }],
        "summary": "Daftar semua user (opsional filter role)",
        "produces": ["application/json"],
        "parameters": [{ "in": "query", "name": "role", "type": "string" }],
        "responses": { "200": { "description": "Daftar user" } }
      }
    },
    "/admin/verifications": {
      "get": {
        "tags": ["Admin"], "security": [{ "BearerAuth": [] }],
        "summary": "Daftar user/toko/kurir yang menunggu verifikasi",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Daftar" } }
      }
    },
    "/admin/verifications/{id}": {
      "post": {
        "tags": ["Admin"], "security": [{ "BearerAuth": [] }],
        "summary": "Approve / reject verifikasi toko/kurir",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "type": "string" },
          { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/AdminVerifyRequest" } }
        ],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },
    "/admin/users/{id}": {
      "delete": {
        "tags": ["Admin"], "security": [{ "BearerAuth": [] }],
        "summary": "Hapus user",
        "produces": ["application/json"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },
    "/admin/users/{id}/deactivate": {
      "put": {
        "tags": ["Admin"], "security": [{ "BearerAuth": [] }],
        "summary": "Non-aktifkan user",
        "produces": ["application/json"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },
    "/admin/users/{id}/verify-ngo": {
      "put": {
        "tags": ["Admin"], "security": [{ "BearerAuth": [] }],
        "summary": "Verifikasi user sebagai NGO",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "type": "string" },
          { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/VerifyNGORequest" } }
        ],
        "responses": { "200": { "description": "Berhasil" } }
      }
    },
    "/admin/reports": {
      "get": {
        "tags": ["Admin"], "security": [{ "BearerAuth": [] }],
        "summary": "Daftar laporan",
        "produces": ["application/json"],
        "responses": { "200": { "description": "Daftar" } }
      }
    },
    "/admin/reports/{id}": {
      "put": {
        "tags": ["Admin"], "security": [{ "BearerAuth": [] }],
        "summary": "Tindaklanjuti laporan (ditinjau / ditindak / ditolak)",
        "consumes": ["application/json"], "produces": ["application/json"],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "type": "string" },
          { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/ReviewReportRequest" } }
        ],
        "responses": { "200": { "description": "Berhasil" } }
      }
    }
  },
  "definitions": {
    "Health": { "type": "object", "properties": { "service": { "type": "string" }, "status": { "type": "string" } } },
    "AuthResponse": {
      "type": "object",
      "properties": { "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIs..." }, "user": { "$ref": "#/definitions/User" } }
    },
    "User": {
      "type": "object",
      "properties": {
        "id": { "type": "string" }, "email": { "type": "string" }, "full_name": { "type": "string" },
        "photo_url": { "type": "string", "x-nullable": true }, "phone_number": { "type": "string", "x-nullable": true },
        "auth_provider": { "type": "string", "enum": ["google", "email_password"] },
        "role": { "type": "string", "enum": ["user", "toko", "kurir", "admin"] },
        "is_ngo_verified": { "type": "boolean" }, "trust_score": { "type": "number", "format": "float" },
        "latitude": { "type": "number", "format": "float", "x-nullable": true },
        "longitude": { "type": "number", "format": "float", "x-nullable": true },
        "address_text": { "type": "string", "x-nullable": true },
        "account_status": { "type": "string", "enum": ["pending_verification", "active", "rejected", "suspended", "deactivated"] },
        "created_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "RegisterRequest": {
      "type": "object", "required": ["email", "full_name", "role"],
      "properties": {
        "email": { "type": "string", "example": "user@example.com" },
        "password": { "type": "string", "minLength": 6, "example": "rahasia123" },
        "full_name": { "type": "string" },
        "phone_number": { "type": "string", "example": "081234567890" },
        "role": { "type": "string", "enum": ["user", "toko", "kurir"], "example": "user" }
      }
    },
    "LoginRequest": {
      "type": "object", "required": ["email", "password"],
      "properties": { "email": { "type": "string" }, "password": { "type": "string" } }
    },
    "GoogleLoginRequest": { "type": "object", "required": ["id_token"], "properties": { "id_token": { "type": "string" } } },
    "GoogleRegisterRequest": {
      "type": "object", "required": ["id_token", "role"],
      "properties": { "id_token": { "type": "string" }, "role": { "type": "string", "enum": ["user", "toko", "kurir"] }, "phone_number": { "type": "string" } }
    },
    "UpdateProfileRequest": {
      "type": "object",
      "properties": {
        "full_name": { "type": "string" }, "phone_number": { "type": "string" }, "photo_url": { "type": "string" },
        "address_text": { "type": "string" }, "latitude": { "type": "number" }, "longitude": { "type": "number" }
      }
    },
    "PaymentMethodCreate": {
      "type": "object", "required": ["provider", "account_reference"],
      "properties": { "provider": { "type": "string" }, "account_reference": { "type": "string" } }
    },
    "TokoProfileCreate": {
      "type": "object", "required": ["business_name", "business_category", "address"],
      "properties": {
        "business_name": { "type": "string", "example": "Toko Amanah" },
        "business_category": { "type": "string", "example": "Sembako" },
        "address": { "type": "string" },
        "legal_document_url": { "type": "string" },
        "operational_hours": { "type": "string", "example": "08:00-21:00" },
        "latitude": { "type": "number", "format": "float" }, "longitude": { "type": "number", "format": "float" }
      }
    },
    "TokoProfile": {
      "type": "object",
      "properties": {
        "id": { "type": "string" }, "user_id": { "type": "string" },
        "business_name": { "type": "string" }, "business_category": { "type": "string" },
        "address": { "type": "string" }, "latitude": { "type": "number" }, "longitude": { "type": "number" },
        "legal_document_url": { "type": "string" }, "operational_hours": { "type": "string" },
        "verification_status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "average_rating": { "type": "number" }, "created_at": { "type": "string" }, "updated_at": { "type": "string" }
      }
    },
    "CourierProfile": {
      "type": "object",
      "properties": {
        "id": { "type": "string" }, "user_id": { "type": "string" }, "vehicle_type": { "type": "string" },
        "id_document_url": { "type": "string" }, "verification_status": { "type": "string" },
        "is_online": { "type": "boolean" }, "current_latitude": { "type": "number" },
        "current_longitude": { "type": "number" }, "average_rating": { "type": "number" }
      }
    },
    "CourierProfileUpdate": {
      "type": "object",
      "properties": { "vehicle_type": { "type": "string" }, "id_document_url": { "type": "string" } }
    },
    "ToggleOnlineRequest": { "type": "object", "properties": { "is_online": { "type": "boolean" } } },
    "LocationRequest": {
      "type": "object", "required": ["latitude", "longitude"],
      "properties": { "latitude": { "type": "number" }, "longitude": { "type": "number" } }
    },
    "DeliveryIDRequest": { "type": "object", "required": ["delivery_id"], "properties": { "delivery_id": { "type": "string" } } },
    "TripStatusRequest": {
      "type": "object", "required": ["delivery_id", "trip_status"],
      "properties": { "delivery_id": { "type": "string" }, "trip_status": { "type": "string", "enum": ["menuju_toko", "barang_diambil", "menuju_user", "diterima_user"] } }
    },
    "ConfirmationCodeRequest": {
      "type": "object", "required": ["delivery_id", "confirmation_code"],
      "properties": { "delivery_id": { "type": "string" }, "confirmation_code": { "type": "string", "example": "X485R2" } }
    },
    "FoodListing": {
      "type": "object",
      "properties": {
        "id": { "type": "string" }, "toko_id": { "type": "string" }, "name": { "type": "string" },
        "category": { "type": "string" }, "description": { "type": "string", "x-nullable": true },
        "photo_url": { "type": "string", "x-nullable": true },
        "initial_price": { "type": "number" }, "minimum_price": { "type": "number" },
        "current_price": { "type": "number" }, "stock_quantity": { "type": "integer" },
        "food_safety_notes": { "type": "string" }, "safe_until": { "type": "string", "format": "date-time" },
        "pickup_start_time": { "type": "string" }, "pickup_end_time": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive", "sold_out", "expired", "pushed_to_community", "discarded"] }
      }
    },
    "CreateListingRequest": {
      "type": "object", "required": ["name", "category", "initial_price", "minimum_price", "stock_quantity", "safe_until"],
      "properties": {
        "name": { "type": "string", "example": "Nasi Box Sisa Expo" },
        "category": { "type": "string" }, "description": { "type": "string" }, "photo_url": { "type": "string" },
        "initial_price": { "type": "number", "minimum": 0 }, "minimum_price": { "type": "number", "minimum": 0 },
        "stock_quantity": { "type": "integer", "minimum": 1 }, "food_safety_notes": { "type": "string" },
        "safe_until": { "type": "string", "format": "date-time", "example": "2026-09-16T18:00:00" },
        "pickup_start_time": { "type": "string", "format": "date-time", "example": "2026-09-16T09:00:00" },
        "pickup_end_time": { "type": "string", "format": "date-time", "example": "2026-09-16T17:00:00" }
      }
    },
    "UpdateListingRequest": {
      "type": "object",
      "properties": {
        "name": { "type": "string" }, "category": { "type": "string" }, "description": { "type": "string" },
        "photo_url": { "type": "string" }, "initial_price": { "type": "number" }, "minimum_price": { "type": "number" },
        "stock_quantity": { "type": "integer" }, "food_safety_notes": { "type": "string" },
        "safe_until": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive", "sold_out", "expired", "pushed_to_community", "discarded"] }
      }
    },
    "PaginatedResponse": {
      "type": "object",
      "properties": {
        "data": { "type": "array", "items": { "type": "object" } },
        "page": { "type": "integer" }, "limit": { "type": "integer" },
        "total": { "type": "integer" }, "total_pages": { "type": "integer" }
      }
    },
    "Order": {
      "type": "object",
      "properties": {
        "id": { "type": "string" }, "listing_id": { "type": "string" }, "user_id": { "type": "string" },
        "quantity": { "type": "integer" }, "price_at_purchase": { "type": "number" },
        "total_amount": { "type": "number" },
        "fulfillment_method": { "type": "string", "enum": ["pickup_mandiri", "diantar_kurir"] },
        "payment_method": { "type": "string" }, "payment_status": { "type": "string" },
        "order_status": { "type": "string" }, "confirmation_code": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }, "completed_at": { "type": "string" }
      }
    },
    "CreateOrderRequest": {
      "type": "object", "required": ["listing_id", "quantity", "fulfillment_method"],
      "properties": {
        "listing_id": { "type": "string" }, "quantity": { "type": "integer", "minimum": 1 },
        "fulfillment_method": { "type": "string", "enum": ["pickup_mandiri", "diantar_kurir"] },
        "payment_method": { "type": "string", "example": "cash" }
      }
    },
    "ConfirmPaymentRequest": { "type": "object", "properties": { "payment_method": { "type": "string" } } },
    "Delivery": {
      "type": "object",
      "properties": {
        "id": { "type": "string" }, "order_id": { "type": "string" },
        "matching_status": { "type": "string" }, "courier_profile_id": { "type": "string", "x-nullable": true },
        "pickup_latitude": { "type": "number" }, "pickup_longitude": { "type": "number" },
        "dropoff_latitude": { "type": "number" }, "dropoff_longitude": { "type": "number" },
        "trip_status": { "type": "string" }, "delivery_fee": { "type": "number" }
      }
    },
    "CreateCommunityPostRequest": {
      "type": "object", "required": ["listing_id", "target_category"],
      "properties": {
        "listing_id": { "type": "string" },
        "target_category": { "type": "string", "enum": ["kompos", "pakan_ternak", "lainnya"], "example": "kompos" },
        "transport_fee": { "type": "number", "minimum": 0 }
      }
    },
    "ClaimCommunityPostRequest": {
      "type": "object", "required": ["community_post_id"],
      "properties": { "community_post_id": { "type": "string" } }
    },
    "CreateEmergencyAlertRequest": {
      "type": "object", "required": ["need_type", "target_area", "urgency_level"],
      "properties": {
        "need_type": { "type": "string", "example": "Makanan siap saji" },
        "target_area": { "type": "string", "example": "Kecamatan Sukamaju" },
        "urgency_level": { "type": "string", "enum": ["rendah", "sedang", "tinggi", "kritis"] },
        "description": { "type": "string" }
      }
    },
    "RespondEmergencyAlertRequest": {
      "type": "object", "required": ["alert_id"],
      "properties": { "alert_id": { "type": "string" }, "availability_note": { "type": "string" } }
    },
    "CreateRatingRequest": {
      "type": "object", "required": ["order_id", "ratee_user_id", "rating_target", "score"],
      "properties": {
        "order_id": { "type": "string" }, "ratee_user_id": { "type": "string" },
        "rating_target": { "type": "string", "enum": ["toko", "kurir", "user"] },
        "score": { "type": "integer", "minimum": 1, "maximum": 5 }, "review_text": { "type": "string" }
      }
    },
    "CreateReportRequest": {
      "type": "object", "required": ["reported_entity_type", "reported_entity_id", "reason"],
      "properties": {
        "reported_entity_type": { "type": "string", "enum": ["listing", "user", "toko", "kurir", "order", "community_post"] },
        "reported_entity_id": { "type": "string" }, "reason": { "type": "string" }
      }
    },
    "CreateChatRequest": { "type": "object", "required": ["order_id"], "properties": { "order_id": { "type": "string" } } },
    "SendMessageRequest": { "type": "object", "required": ["message_text"], "properties": { "message_text": { "type": "string" } } },
    "AIChatRequest": {
      "type": "object", "required": ["message", "source"],
      "properties": {
        "listing_id": { "type": "string" }, "message": { "type": "string" },
        "photo_url": { "type": "string" },
        "source": { "type": "string", "enum": ["dari_listing", "deteksi_kamera"] }
      }
    },
    "AIContinueRequest": { "type": "object", "required": ["message"], "properties": { "message": { "type": "string" } } },
    "DetectPhotoRequest": { "type": "object", "required": ["photo_url"], "properties": { "photo_url": { "type": "string" } } },
    "CreatePaymentRequest": {
      "type": "object", "required": ["order_id", "gross_amt"],
      "properties": { "order_id": { "type": "string" }, "gross_amt": { "type": "number" } }
    },
    "AdminVerifyRequest": {
      "type": "object", "required": ["status"],
      "properties": { "status": { "type": "string", "enum": ["approved", "rejected"] } }
    },
    "VerifyNGORequest": { "type": "object", "required": ["is_verified"], "properties": { "is_verified": { "type": "boolean" } } },
    "ReviewReportRequest": {
      "type": "object", "required": ["status"],
      "properties": { "status": { "type": "string", "enum": ["ditinjau", "ditindak", "ditolak"] } }
    }
  }
}